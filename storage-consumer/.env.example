# AWS S3: set a bucket NAME, not an s3:// URI or a presigned object URL.
S3_RAW_BUCKET=replace-with-your-versioned-bucket
S3_RAW_PREFIX=raw-sensor
AWS_REGION=ap-southeast-1
# Leave empty for AWS; set e.g. http://127.0.0.1:9000 for explicit local MinIO.
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
S3_ALLOW_UNVERSIONED=false
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
# Credentials use boto3's standard chain. Prefer IRSA on Kubernetes.
# Do not commit access keys or presigned URLs.

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_CLIENT_ID=maintai-storage
KAFKA_LOCAL_MODE=false
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_POLL_INTERVAL_SECONDS=0.1
# Custom group prefixes are local-only; use a stable prefix across restarts.
KAFKA_GROUP_PREFIX=

STORAGE_ARCHIVE_OUTCOMES=false
# M6 catalog is opt-in; requires versioning and raw-only groups. No AWS needed with MinIO.
STORAGE_CATALOG_ENABLED=false
STORAGE_CATALOG_PREFIX=raw-catalog/v1
STORAGE_CATALOG_INTERVAL_SECONDS=5
STORAGE_CATALOG_BATCH_RECORDS=100
STORAGE_CATALOG_POLL_SECONDS=0.5
STORAGE_CATALOG_HEARTBEAT_SECONDS=30
STORAGE_HTTP_HOST=0.0.0.0
STORAGE_HTTP_PORT=8008
STORAGE_RETRY_ATTEMPTS=5
STORAGE_RETRY_INITIAL_SECONDS=1
STORAGE_RETRY_MAX_SECONDS=15
STORAGE_PROBE_INTERVAL_SECONDS=15
STORAGE_PROBE_TIMEOUT_SECONDS=3
STORAGE_READINESS_MAX_AGE_SECONDS=60
STORAGE_LIVENESS_MAX_AGE_SECONDS=90
