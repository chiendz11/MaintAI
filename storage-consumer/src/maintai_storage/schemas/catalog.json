{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maintai:storage:catalog:1.0.0",
  "title": "M6-RAW-01 catalog protocol 1.0.0",
  "$defs": {
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bucket",
        "key",
        "version_id",
        "sha256"
      ]
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_schema_version": {
          "const": "1.0.0"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "topic": {
          "enum": [
            "sensor.readings",
            "sensor.rejected"
          ]
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_event_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "machine_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "server_accepted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "source_identity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_kind": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "raw_object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "raw_manifest_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "event_locator": {
          "const": 0
        }
      },
      "required": [
        "catalog_schema_version",
        "receipt_id",
        "topic",
        "partition",
        "offset",
        "source_event_id",
        "machine_id",
        "received_at",
        "server_accepted_at",
        "source_identity",
        "request_id",
        "receipt_kind",
        "raw_object_ref",
        "raw_manifest_ref",
        "event_locator"
      ]
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_offset": {
          "type": "integer",
          "minimum": 0
        },
        "to_offset": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "RETENTION_UNVERIFIABLE",
            "LOG_TRUNCATED",
            "RAW_CORRUPT"
          ]
        }
      },
      "required": [
        "from_offset",
        "to_offset",
        "reason"
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "enum": [
            "sensor.readings",
            "sensor.rejected"
          ]
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "archived_next_offset": {
          "type": "integer",
          "minimum": 0
        },
        "indexed_next_offset": {
          "type": "integer",
          "minimum": 0
        },
        "captured_log_end_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "gaps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Gap"
          }
        },
        "status": {
          "enum": [
            "COMPLETE",
            "LAGGING",
            "GAP",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "topic",
        "partition",
        "topic_id",
        "start_offset",
        "archived_next_offset",
        "indexed_next_offset",
        "captured_log_end_offset",
        "captured_at",
        "gaps",
        "status"
      ]
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Entry"
          }
        }
      },
      "required": [
        "schema_version",
        "entries"
      ]
    },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "source_cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "segments": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "partitions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/Coverage"
          }
        }
      },
      "required": [
        "schema_version",
        "generation_id",
        "published_at",
        "source_cluster_id",
        "parent_ref",
        "segments",
        "partitions"
      ]
    },
    "Pointer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "schema_version",
        "generation_id",
        "generation_ref"
      ]
    }
  }
}
