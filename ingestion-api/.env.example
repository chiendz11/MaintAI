# Explicit anonymous fixture profile; bind loopback only. Never use for shared deployment.
INGESTION_ENV=local
INGESTION_HOST=127.0.0.1
INGESTION_PORT=8000
AUTH_MODE=local-fixture
LOCAL_SOURCE_SUBJECT=local-sensor-fixture
LOCAL_ALLOWED_MACHINE_IDS=M-001
BUSINESS_PUBLIC_ORIGIN=http://127.0.0.1:8003
KAFKA_LOCAL_MODE=true
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=maintai-ingestion-local
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_MAX_PAYLOAD_BYTES=262144
INGESTION_MAX_INFLIGHT=8
INGESTION_BODY_TIMEOUT_SECONDS=10
INGESTION_PROBE_TIMEOUT_SECONDS=1
INGESTION_PROBE_INTERVAL_SECONDS=5
# Shared deployment: AUTH_MODE=oidc; INGESTION_ENV=shared; KAFKA_LOCAL_MODE=false.
# Set actual HTTPS BUSINESS_PUBLIC_ORIGIN, OIDC_ISSUER, OIDC_JWKS_URL,
# OIDC_ROLES_CLAIM, OIDC_MACHINES_CLAIM, OIDC_ALGORITHMS, plus SDK SASL_SSL/CA
# and PRODUCER_GIT_SHA from actual source revision. Never put secrets in this file.
