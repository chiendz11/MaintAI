# Explicit local-only profile. Production uses SASL_SSL + SCRAM + real CA/secrets.
KAFKA_LOCAL_MODE=true
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID=maintai-local
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_ENABLE_AUTO_OFFSET_STORE=false
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_MAX_PAYLOAD_BYTES=262144
# Use a prefix only when deliberately sharing a local development broker.
KAFKA_GROUP_PREFIX=
# Local integration-test database only. Owner credentials differ in deployment.
PROCESSING_DATABASE_URL=postgresql://maintai_dev:maintai_dev@127.0.0.1:15432/maintai_messaging_dev
# The local compose database can also be used by a single isolated test at a time.
# Real Business uses its own business_db and credentials.
BUSINESS_DATABASE_URL=
BUSINESS_PUBLIC_ORIGIN=http://127.0.0.1:8003
S3_RAW_BUCKET=
S3_RAW_PREFIX=raw-sensor
S3_ENDPOINT_URL=
S3_ALLOW_UNVERSIONED=false
