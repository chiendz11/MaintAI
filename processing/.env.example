# Explicit local test profile. Shared worker handoff is not enabled by this file.
PROCESSING_PROFILE=local-fixture
# Opt-in after explicit migration + activate-ordering --legacy-writers-drained.
PROCESSING_EXECUTION_MODE=keyed
OUTBOX_EXECUTION_MODE=ordered
KAFKA_LOCAL_MODE=true
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:39092
KAFKA_GROUP_PREFIX=m2-local-fixture-
KAFKA_DELIVERY_TIMEOUT_MS=3000
# Set this to the actual app Git object ID; there is no generated/fake default.
PRODUCER_GIT_SHA=
PROCESSING_DATABASE_URL=postgresql://maintai_test:maintai_test@127.0.0.1:35432/maintai_processing_test
BUSINESS_BASE_URL=http://127.0.0.1:48000
ML_BASE_URL=http://127.0.0.1:48001
# Optional signed registry token for the implemented Business API; never commit a token.
BUSINESS_BEARER_TOKEN=
PROCESSING_SCHEMA_DIRECTORY=contracts/v1.3/schemas
PROCESSING_VALIDATOR_VERSION=sensor-validator-1.0.0
PROCESSING_RISK_POLICY_FILE=processing/worker/tests/fixtures/risk-policy.json
PROCESSING_MODEL_IDENTITY_FIXTURE=contracts/kafka/examples/completed.json
# Use distinct ports for worker and relay. Defaults are 8081 and 8082.
PROCESSING_OUTBOX_BATCH_SIZE=1
PROCESSING_OUTBOX_LEASE_SECONDS=120
# Probe bind only; use 0.0.0.0 explicitly if platform needs a network probe.
PROCESSING_HEALTH_HOST=127.0.0.1
