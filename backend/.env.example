# Local Business API/Consumer configuration. Auth remains required for HTTP.
BUSINESS_PROFILE=local-test
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8003
# Set an owner Business DB URL; never point to processing_db.
BUSINESS_DATABASE_URL=
# Explicit external/test issuer settings and reviewed claim mapping, no guessed defaults.
BUSINESS_OIDC_ISSUER=
BUSINESS_OIDC_AUDIENCE=
BUSINESS_OIDC_JWKS_URL=
BUSINESS_ROLES_CLAIM=
BUSINESS_MACHINES_CLAIM=
# Set both to enable the status facade; keep the service token out of this file.
BUSINESS_PROCESSING_READ_URL=
BUSINESS_PROCESSING_TOKEN_FILE=
# Separate Consumer entrypoint, same Business DB owner.
BUSINESS_CONSUMER_PROFILE=local-test
BUSINESS_CONSUMER_HOST=127.0.0.1
BUSINESS_CONSUMER_PORT=8083
KAFKA_LOCAL_MODE=true
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:39092

# Business SSE: API and Consumer use the same owner-local channel.
BUSINESS_NOTIFY_CHANNEL=maintai_business_live_v1
BUSINESS_SSE_MAX_CONNECTIONS=128
BUSINESS_SSE_CONNECTION_BYTES=2097152
BUSINESS_SSE_TOTAL_BYTES=8388608
