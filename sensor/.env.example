# Shared profile; replace illustrative URLs and mount secret files before use.
BACKEND_BASE_URL=https://ingestion.example.invalid
SIM_DATASET_PATH=sensor/data/ai4i2020.csv
SIM_SCENARIO_PATH=sensor/scenarios
SIM_STATE_PATH=sensor/output/state.sqlite3
SIM_HOST=0.0.0.0
SIM_PORT=8005
SIM_AUTH_MODE=jwt
SIM_JWT_ISSUER=https://identity.example.invalid/realms/maintai
SIM_JWKS_URL=https://identity.example.invalid/realms/maintai/protocol/openid-connect/certs
SIM_JWT_AUDIENCE=simulator-control
SIM_ROLES_CLAIM=roles
SIM_MACHINES_CLAIM=machine_ids
SIM_CONTROL_SCOPE=simulator:control
SIM_CORS_ORIGINS='["https://simulator.example.invalid"]'
SIM_INGESTION_AUTH=token_file
SIM_INGESTION_TOKEN_FILE=/run/secrets/sensor-ingestion-token
# For client credentials, select oauth and mount the secret instead:
# SIM_OAUTH_TOKEN_URL=https://identity.example.invalid/realms/maintai/protocol/openid-connect/token
# SIM_OAUTH_CLIENT_ID=maintai-sensor
# SIM_OAUTH_SECRET_FILE=/run/secrets/sensor-oauth-secret
# SIM_OAUTH_SCOPE=sensor:write
SIM_MACHINE_COUNT=5
SIM_INTERVAL_MS=1000
SIM_SPEED=1
SIM_SEED=42
SIM_SCENARIO=normal
SIM_INITIAL_STATE=RUNNING
SIM_LOOP_DATASET=true
SIM_FAULT_MODE=none
SIM_FAULT_EVERY=1
SIM_FAULT_FIELD=rotational_speed_rpm
SIM_TIMEOUT_SECONDS=5
SIM_RETRY_BACKOFF_MS=100
SIM_RETRY_MAX_SECONDS=60
SIM_SEND_WORKERS=4
SIM_SPOOL_MAX_RECORDS=10000
SIM_SPOOL_MAX_BYTES=32000000
SIM_SPOOL_TTL_SECONDS=86400
SIM_RECEIPT_MAX_COUNT=100000
# Local explicit profile must also bind loopback:
# SIM_AUTH_MODE=local
# SIM_HOST=127.0.0.1
# SIM_INGESTION_AUTH=none
# BACKEND_BASE_URL=http://127.0.0.1:8000
# SIM_CORS_ORIGINS='["http://127.0.0.1:5174"]'
