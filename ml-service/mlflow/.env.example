# Local-only Compose inputs. This file is not production desired state.
# Set reviewed upstream MLflow and PostgreSQL image@sha256 references; never latest.
MLFLOW_BASE_IMAGE=
POSTGRES_IMAGE=
MLFLOW_LOCAL_IMAGE=maintai-mlflow:dev
MLFLOW_LOCAL_PORT=5000
MLFLOW_DB_PASSWORD=local_dev_only_change_me
# Artifact storage is a local volume in this stack, not AWS S3/MinIO.
# Production PostgreSQL/S3/IAM/auth configuration stays in MaintAI-gitops.
