# Build context: repository root.
# Authenticated local integration candidate; not an approved release.

FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MODEL_DIR=/models/current

WORKDIR /app

COPY ml-service/inference/requirements-auth.lock /opt/maintai/requirements-auth.lock

RUN python -m pip install --no-cache-dir --timeout 120 --retries 5 \
        -r /opt/maintai/requirements-auth.lock \
    && python -m pip check \
    && useradd --uid 10001 --create-home mluser

COPY ml-service/inference/api/local_baseline.py /app/local_baseline.py
COPY ml-service/inference/api/auth_core.py /app/auth_core.py
COPY ml-service/inference/api/auth_runtime.py /app/auth_runtime.py
COPY ml-service/inference/api/authenticated_local.py /app/authenticated_local.py
COPY ml-service/shared/preprocessing/feature_interactions.py /app/feature_interactions.py

USER mluser

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "authenticated_local:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-proxy-headers"]