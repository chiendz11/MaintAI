{
  "service": "maintai-rag",
  "version": "1.4.0",
  "runtime": {
    "language": "python",
    "python_version": "3.11",
    "framework": "fastapi",
    "entrypoint": "main:app",
    "command": [
      "uvicorn",
      "main:app",
      "--host",
      "0.0.0.0",
      "--port",
      "8002"
    ],
    "port": 8002
  },
  "container": {
    "dockerfile": "rag-service/Dockerfile",
    "build_context": ".",
    "image": "maintai-rag:pr14"
  },
  "health": {
    "liveness": "/health/live",
    "readiness": "/health/ready"
  },
  "dependencies": {
    "database": "postgresql-pgvector",
    "llm_provider": "groq-api",
    "embedding": "sentence-transformers"
  },
  "environment": {
    "required": [
      "DATABASE_URL",
      "GROQ_MODEL",
      "EMBEDDING_MODEL"
    ],
    "optional": {
      "HF_HOME": "/opt/maintai/model-cache",
      "SENTENCE_TRANSFORMERS_HOME": "/opt/maintai/model-cache",
      "MODEL_LOCAL_FILES_ONLY": "true",
      "GROQ_TIMEOUT_SECONDS": "60",
      "GROQ_MAX_COMPLETION_TOKENS": "2048"
    },
    "required_any_of": [
      [
        "GROQ_API_KEY",
        "GROQ_API_KEY_FILE"
      ]
    ]
  },
  "commands": {
    "migration": "python -m migrations.cli up",
    "ingestion": "python -m ingestion.cli --pdf <path> --document-id <id> --version <version> --section <section>",
    "embedding_preparation": "python -m ingestion.prepare_embedding"
  },
  "deployment": {
    "platform": "kubernetes",
    "local_cluster": "k3d",
    "manifest_directory": "rag-service/k8s",
    "llm_provider_location": "external-api",
    "llm_endpoint": "https://api.groq.com/openai/v1/chat/completions"
  },
  "runtime_id": "rag-service",
  "target_contract_revision": "1.3.2",
  "dockerfile": "rag-service/Dockerfile",
  "source_paths": [
    "rag-service/main.py",
    "rag-service/ingestion",
    "rag-service/knowledge",
    "rag-service/migrations",
    "rag-service/vector_retriever",
    "rag-service/llm_generator",
    "rag-service/runtime_config.py",
    "rag-service/pipeline.py",
    "rag-service/api"
  ]
}
