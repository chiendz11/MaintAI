# Local-only placeholders. Supply real credentials outside Git.
DATABASE_URL=postgresql://maintai:CHANGE_ME@postgres-service:5432/knowledge_db
GROQ_API_KEY=CHANGE_ME
# Alternatively remove GROQ_API_KEY and mount a Secret file:
# GROQ_API_KEY_FILE=/run/secrets/groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=2048
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HOME=/opt/maintai/model-cache
SENTENCE_TRANSFORMERS_HOME=/opt/maintai/model-cache
MODEL_LOCAL_FILES_ONLY=true
