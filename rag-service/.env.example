# RAG container: use reachable host/service names, not localhost for external services.
DATABASE_URL=postgresql://maintai:CHANGE_ME@postgres-service:5432/knowledge_db
OLLAMA_BASE_URL=http://host.k3d.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HOME=/opt/maintai/model-cache
SENTENCE_TRANSFORMERS_HOME=/opt/maintai/model-cache
MODEL_LOCAL_FILES_ONLY=true
