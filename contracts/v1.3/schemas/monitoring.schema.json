{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitoring read models; worker freshness and data drift are separate",
  "$defs": {
    "Service": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/DependencyStatus"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "message"
      ],
      "additionalProperties": false
    },
    "LatestReport": {
      "type": "object",
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        },
        "overall_status": {
          "$ref": "drift-report.schema.json#/$defs/DriftStatus"
        },
        "window_end_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "report_id",
        "computed_at",
        "overall_status",
        "window_end_at",
        "model_version"
      ],
      "additionalProperties": false
    },
    "DriftSummary": {
      "type": "object",
      "properties": {
        "worker_status": {
          "type": "string",
          "enum": [
            "FRESH",
            "STALE",
            "NOT_AVAILABLE"
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale_after_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "latest_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/LatestReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "worker_status",
        "last_success_at",
        "stale_after_seconds",
        "latest_report"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "worker_status": {
                "enum": [
                  "FRESH",
                  "STALE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "last_success_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "worker_status": {
                "const": "NOT_AVAILABLE"
              }
            }
          },
          "then": {
            "properties": {
              "last_success_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Summary": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/DependencyStatus"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "services": {
          "type": "object",
          "properties": {
            "backend": {
              "$ref": "#/$defs/Service"
            },
            "ml": {
              "$ref": "#/$defs/Service"
            },
            "rag": {
              "$ref": "#/$defs/Service"
            }
          },
          "required": [
            "backend",
            "ml",
            "rag"
          ],
          "additionalProperties": false
        },
        "drift": {
          "$ref": "#/$defs/DriftSummary"
        }
      },
      "required": [
        "status",
        "observed_at",
        "services",
        "drift"
      ],
      "additionalProperties": false
    }
  }
}
