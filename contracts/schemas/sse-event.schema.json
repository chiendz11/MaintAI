{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parsed SSE event envelope; wire transport is text/event-stream",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "machine.updated"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/machine.updated"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "alert.created"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/alert.created"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "alert.updated"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/alert.updated"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "brief.ready"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/brief.ready"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "service.degraded"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "#/$defs/service.degraded"
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "machine.updated": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "common.schema.json#/$defs/MachineState"
        }
      },
      "required": [
        "machine_id",
        "state"
      ],
      "additionalProperties": false
    },
    "alert.created": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "minLength": 1
        },
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/AlertSeverity"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/AlertStatus"
        }
      },
      "required": [
        "alert_id",
        "machine_id",
        "severity",
        "status"
      ],
      "additionalProperties": false
    },
    "alert.updated": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "minLength": 1
        },
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/AlertSeverity"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/AlertStatus"
        }
      },
      "required": [
        "alert_id",
        "machine_id",
        "severity",
        "status"
      ],
      "additionalProperties": false
    },
    "brief.ready": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "minLength": 1
        },
        "brief_id": {
          "type": "string",
          "minLength": 1
        },
        "grounded_status": {
          "type": "string",
          "enum": [
            "GROUNDED",
            "INSUFFICIENT_EVIDENCE",
            "VALIDATION_FAILED"
          ]
        }
      },
      "required": [
        "alert_id",
        "brief_id",
        "grounded_status"
      ],
      "additionalProperties": false
    },
    "service.degraded": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "enum": [
            "backend",
            "ml-inference",
            "rag-service"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DEGRADED",
            "UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "service",
        "status",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
