{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete Alert DTO (baseline section 10.2)",
  "type": "object",
  "properties": {
    "alert_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "machine_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "prediction_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/AlertSeverity"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/AlertStatus"
    },
    "risk_score": {
      "$ref": "common.schema.json#/$defs/Probability"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  },
  "required": [
    "alert_id",
    "machine_id",
    "event_id",
    "prediction_id",
    "severity",
    "status",
    "risk_score",
    "model_version",
    "policy_version",
    "dedupe_key",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
