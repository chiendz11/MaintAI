          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dq_ruleset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "const": "DATA_INVALID"
        },
        "validation_status": {
          "const": "INVALID"
        },
        "processing_status": {
          "const": "INVALID"
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 256
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "field",
              "code"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "event_id",
        "machine_id",
        "stream_epoch",
        "sequence_number",
        "source_schema_version",
        "source_topic",
        "source_partition",
        "source_offset",
        "source_server_accepted_at",
        "occurred_at",
        "correlation_id",
