{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaintAI v1.4 terminal outcome; new writes only",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.4.0"
        },
        "result_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "machine_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stream_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 1
        },
        "source_schema_version": {
          "const": "1.3.0"
        },
        "source_topic": {
          "const": "sensor.readings"
        },
        "source_partition": {
          "type": "integer",
          "minimum": 0
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_server_accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "producer_git_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dq_ruleset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dq_ruleset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "const": "PREDICTION_COMPLETED"
        },
        "validation_status": {
          "const": "VALID"
        },
        "processing_status": {
          "const": "COMPLETED"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prediction": {
          "enum": [
            "NORMAL",
            "FAILURE"
          ]
        },
        "failure_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "preprocessor_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mlflow_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preprocessor_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "feature_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "feature_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "inference_image_digest": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
        },
        "risk_decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "machine_state": {
          "enum": [
            "NORMAL",
            "WATCH",
            "HIGH",
            "CRITICAL"
          ]
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "event_id",
        "machine_id",
        "stream_epoch",
        "sequence_number",
        "source_schema_version",
        "source_topic",
        "source_partition",
        "source_offset",
        "source_server_accepted_at",
        "occurred_at",
        "correlation_id",
        "producer_git_sha",
        "dq_ruleset_version",
        "dq_ruleset_sha256",
        "kind",
        "validation_status",
        "processing_status",
        "prediction_id",
        "prediction",
        "failure_probability",
        "model_threshold",
        "model_version",
        "preprocessor_version",
        "dataset_version",
        "dataset_manifest_sha256",
        "split_sha256",
        "mlflow_run_id",
        "model_artifact_sha256",
        "preprocessor_sha256",
        "feature_schema_version",
        "feature_schema_sha256",
        "release_id",
        "inference_image_digest",
        "risk_decision_id",
        "policy_version",
        "policy_sha256",
        "machine_state",
        "risk_score",
        "completed_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.4.0"
        },
        "result_id": {
          "type": "string",
